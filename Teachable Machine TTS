<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI 가위바위보 모바일</title>
    <style>
        body { font-family: sans-serif; text-align: center; background-color: #f0f2f5; padding-top: 30px; }
        #webcam-container { margin: 10px auto; width: 250px; height: 250px; background: #000; border-radius: 20px; overflow: hidden; }
        #label-container { font-size: 50px; font-weight: bold; color: #ff4757; margin-top: 20px; }
        button { width: 200px; height: 60px; font-size: 20px; background-color: #2ed573; color: white; border: none; border-radius: 30px; box-shadow: 0 4px 10px rgba(0,0,0,0.2); }
    </style>
</head>
<body>

    <h2>📱 모바일 AI 가위바위보</h2>
    <button type="button" onclick="init()">시작하기 (Start)</button>
    
    <div id="webcam-container"></div>
    <div id="label-container">버튼 클릭!</div>

    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@latest/dist/tf.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@teachablemachine/image@latest/dist/teachablemachine-image.min.js"></script>

    <script type="text/javascript">
        const URL = "./my_model/"; 
        let model, webcam, labelContainer;
        let lastSpeech = ""; 
        let isActivated = false; // 음성 활성화 상태 변수

        async function init() {
            // [중요] 사용자가 버튼을 눌렀을 때 빈 소리를 재생하여 휴대폰 음성 잠금 해제
            const welcomeUtterance = new SpeechSynthesisUtterance("준비 완료");
            welcomeUtterance.lang = 'ko-KR';
            welcomeUtterance.volume = 0; // 처음엔 무음으로 시스템만 깨움
            window.speechSynthesis.speak(welcomeUtterance);
            isActivated = true;

            const modelURL = URL + "model.json";
            const metadataURL = URL + "metadata.json";

            model = await tmImage.load(modelURL, metadataURL);
            
            // 모바일에서는 전면/후면 카메라 설정이 중요할 수 있어 기본 설정 사용
            const flip = true; 
            webcam = new tmImage.Webcam(250, 250, flip); 
            await webcam.setup({ facingMode: "user" }); // 전면 카메라 요청
            await webcam.play();
            window.requestAnimationFrame(loop);

            document.getElementById("webcam-container").appendChild(webcam.canvas);
            labelContainer = document.getElementById("label-container");
            labelContainer.innerHTML = "인식 중...";
        }

        async function loop() {
            webcam.update(); 
            await predict();
            window.requestAnimationFrame(loop);
        }

        async function predict() {
            const prediction = await model.predict(webcam.canvas);
            let currentResult = "";

            // 확률 기준 0.70
            if(prediction[0].probability >= 0.70) {
                currentResult = "바위";
            } 
            else if (prediction[1].probability >= 0.70) {
                currentResult = "보";
            } 
            else {
                currentResult = "인식 중...";
            }

            labelContainer.innerHTML = currentResult;

            // 음성 출력 (이전과 다를 때만)
            if (isActivated && currentResult !== "인식 중..." && currentResult !== lastSpeech) {
                speak(currentResult);
                lastSpeech = currentResult; 
            } 
            else if (currentResult === "인식 중...") {
                lastSpeech = "";
            }
        }

        function speak(text) {
            window.speechSynthesis.cancel(); // 겹침 방지
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'ko-KR';
            utterance.rate = 1.0;
            utterance.volume = 1.0; // 볼륨 최대
            window.speechSynthesis.speak(utterance);
        }
    </script>
</body>
</html>
